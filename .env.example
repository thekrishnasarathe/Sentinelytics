# Social Media & E-Commerce Sentiment Analysis Platform
# Environment Configuration Example

# Official YouTube Data API v3 Key
YOUTUBE_API_KEY=your_youtube_api_key_here

# Optional Gemini API Key (for LLM deep contextual summarization)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Instagram Graph API Token
INSTAGRAM_ACCESS_TOKEN=your_instagram_token_here

# Optional Scraper API Key (for Amazon Rainforest / RapidAPI proxy scraping)
SCRAPER_API_KEY=your_scraper_api_key_here

# Host / App URL
APP_URL=http://localhost:3000
